# Supabase Configuration
# Get these values from your Supabase project settings: https://app.supabase.com
# Settings > API > Project URL and Project API keys

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Example:
# NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Enable quick test-profile access (/accesos-prueba and /api/demo/signin)
ENABLE_DEMO_ACCESS=false
NEXT_PUBLIC_ENABLE_DEMO_ACCESS=false
DEMO_ACCOUNTS_PASSWORD=ResigestTest2026!
